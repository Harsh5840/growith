generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
	url      = env("DATABASE_URL")
}

model InvestorAuthUser {
	id                       Int       @id @default(autoincrement())
	email                    String    @unique
	fullName                 String
	passwordHash             String?
	googleId                 String?   @unique
	profilePicture           String?
	emailVerified            Boolean   @default(false)
	isActive                 Boolean   @default(true)
	forgotPasswordCode       String?
	forgotPasswordExpires    DateTime?
	emailVerificationCode    String?
	emailVerificationExpires DateTime?
	lastLoginAt              DateTime?
	kycStatus                String    @default("PENDING")
	walletTokenBalance       Int       @default(0)
	createdAt                DateTime  @default(now())
	updatedAt                DateTime  @updatedAt

	kyc                   InvestorKyc?
	tokenPurchaseRequests TokenPurchaseRequest[]
}

model AdminUser {
	id                       Int       @id @default(autoincrement())
	email                    String    @unique
	fullName                 String
	passwordHash             String
	isActive                 Boolean   @default(true)
	forgotPasswordCode       String?
	forgotPasswordExpires    DateTime?
	lastLoginAt              DateTime?
	createdAt                DateTime  @default(now())
	updatedAt                DateTime  @updatedAt
}

model InvestorKyc {
	id                    Int       @id @default(autoincrement())
	userId                Int       @unique
	user                  InvestorAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

	// Personal Info
	fullLegalName         String
	dateOfBirth           String
	nationality           String
	countryOfResidence    String
	city                  String
	stateProvince         String
	phoneNumber           String
	streetAddress         String

	// Aadhaar Card (required)
	aadhaarNumber         String
	aadhaarFrontUrl       String          // S3 key
	aadhaarBackUrl        String          // S3 key

	// PAN Card (required)
	panNumber             String
	panFrontUrl           String          // S3 key

	// Supporting Document (optional)
	supportingDocName     String?
	supportingDocUrl      String?         // S3 key

	// Terms & Conditions
	termsAgreedAt         DateTime        // When user agreed to T&C

	// Admin Review
	status                String    @default("PENDING_APPROVAL")   // PENDING_APPROVAL | APPROVED | REJECTED
	rejectionReason       String?
	reviewedBy            Int?            // Admin user ID
	reviewedAt            DateTime?

	createdAt             DateTime  @default(now())
	updatedAt             DateTime  @updatedAt
}

model TokenPurchaseRequest {
	id                 Int              @id @default(autoincrement())
	userId             Int
	user               InvestorAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
	requestedTokenCount Int
	totalAmountUsd     Decimal          @db.Decimal(12, 3)
	paymentProofUrl    String
	status             String           @default("PENDING") // PENDING | APPROVED | REJECTED
	rejectionReason    String?
	adminNote          String?
	reviewedBy         Int?
	reviewedAt         DateTime?
	creditedAt         DateTime?
	createdAt          DateTime         @default(now())
	updatedAt          DateTime         @updatedAt

	@@index([userId, createdAt])
	@@index([status, createdAt])
}
